APP_NAME=Lestari
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ─── Octane / FrankenPHP ──────────────────────────────────────────────────────
# Server: frankenphp | swoole | roadrunner
OCTANE_SERVER=frankenphp
# Port HTTP yang didengarkan FrankenPHP (di belakang Nginx reverse proxy)
OCTANE_PORT=8000
# Jumlah PHP worker. 'auto' = jumlah CPU core. Rekomendasi 4CPU: 3
OCTANE_WORKERS=3
# Worker task tambahan untuk concurrentTask()
OCTANE_TASK_WORKERS=2
# Restart worker setelah N request (cegah memory leak jangka panjang)
OCTANE_MAX_REQUESTS=500
# TLS: false jika TLS di-terminate Nginx/Cloudflare (rekomendasi)
OCTANE_HTTPS=false
OCTANE_HTTPS_PORT=443
# Admin endpoint FrankenPHP: false di production
OCTANE_FRANKEN_ADMIN=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Unix socket (production) | TCP loopback (local dev: 127.0.0.1)
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_DATABASE=tokovasbungafloria
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=redis
CACHE_PREFIX=api-lestari

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Unix socket (production): host=path_to_sock, port=0
# TCP loopback (local dev): host=127.0.0.1, port=6379
REDIS_HOST=/var/run/redis/redis.sock
REDIS_PASSWORD=null
REDIS_PORT=0
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_PERSISTENT=true

MAIL_MAILER=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Lestari No Reply"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


BROADCAST_CONNECTION=reverb
REVERB_APP_ID=123456
REVERB_APP_KEY=floria_reverb_key
REVERB_APP_SECRET=floria_reverb_secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

PUSHER_APP_ID="${REVERB_APP_ID}"
PUSHER_APP_KEY="${REVERB_APP_KEY}"
PUSHER_APP_SECRET="${REVERB_APP_SECRET}"
PUSHER_HOST="${REVERB_HOST}"
PUSHER_PORT="${REVERB_PORT}"
PUSHER_SCHEME="${REVERB_SCHEME}"
PUSHER_APP_CLUSTER="mt1"

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
MIDTRANS_SERVER_KEY="your_midtrans_server_key"
MIDTRANS_CLIENT_KEY="your_midtrans_client_key"
MIDTRANS_IS_PRODUCTION=false
MAIL_ENCRYPTION=tls

CORS_ALLOWED_ORIGINS=http://localhost:3000
